{
  "version": 1,
  "conventions": {
    "headerPattern": "^[a-z][a-z0-9_]*$",
    "dateFormat": "YYYY-MM-DD",
    "timestampFormat": "ISO-8601",
    "emptyValue": "blank",
    "mergedCellsAllowed": false,
    "multipleTablesPerSheetAllowed": false
  },
  "tables": [
    { "sheet": "Employees", "table": "employees", "primaryKey": "employee_id", "firstHeader": "employee_id" },
    { "sheet": "Members", "table": "members", "primaryKey": "member_id", "firstHeader": "member_id" },
    { "sheet": "Member programs", "table": "member_programs", "primaryKey": "enrollment_id", "firstHeader": "enrollment_id" },
    { "sheet": "Sales", "table": "sales", "primaryKey": "sale_id", "firstHeader": "sale_id" },
    { "sheet": "Remittances", "table": "remittances", "primaryKey": "remittance_id", "firstHeader": "remittance_id" },
    { "sheet": "Remittance Collections", "table": "remittance_collections", "primaryKey": "remittance_collection_id", "firstHeader": "remittance_collection_id", "compositeKey": ["remittance_id", "collection_id"] },
    { "sheet": "Collections", "table": "collections", "primaryKey": "collection_id", "firstHeader": "collection_id" },
    { "sheet": "Programs", "table": "programs", "primaryKey": "program_id", "firstHeader": "program_id" },
    { "sheet": "Program Incentives", "table": "program_incentives", "primaryKey": "incentive_id", "firstHeader": "incentive_id" },
    { "sheet": "Branches", "table": "branches", "primaryKey": "branch_id", "firstHeader": "branch_id" },
    { "sheet": "Users", "table": "users", "primaryKey": "user_id", "firstHeader": "user_id" },
    { "sheet": "Roles", "table": "roles", "primaryKey": "role_id", "firstHeader": "role_id" },
    { "sheet": "User Roles", "table": "user_roles", "primaryKey": "user_id", "firstHeader": "user_id", "compositeKey": ["user_id", "role_id"] },
    { "sheet": "Attendance", "table": "attendance", "primaryKey": "attendance_id", "firstHeader": "attendance_id" },
    { "sheet": "Leave Requests", "table": "leave_requests", "primaryKey": "leave_request_id", "firstHeader": "leave_request_id" },
    { "sheet": "Expenses", "table": "expenses", "primaryKey": "expense_id", "firstHeader": "expense_id" },
    { "sheet": "Cash Transactions", "table": "cash_transactions", "primaryKey": "transaction_id", "firstHeader": "transaction_id" }
  ],
  "columnTypes": {
    "*_id": "text",
    "*_number": "text",
    "contact_number": "text",
    "phone_number": "text",
    "email": "text",
    "*_amount": "number",
    "amount_*": "number",
    "base_pay": "number",
    "mark_up": "number",
    "nop": "integer",
    "nop_from": "integer",
    "nop_to": "integer",
    "*_date": "date",
    "date_*": "date",
    "doi": "date",
    "*_at": "timestamp",
    "remittance_breakdown": "json"
  }
}
