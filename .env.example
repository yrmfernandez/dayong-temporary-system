# Add these server-only variables locally in .env.local and in the Vercel
# Production environment. Never commit real credentials.
AUTH_SECRET=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Supabase PostgreSQL. Local development uses the staging project; production values go in Vercel only.
# DATABASE_URL: transaction pooler (port 6543), used by the app.
# DIRECT_DATABASE_URL: session pooler (port 5432), used by migrations and scripts/copy-sheets-to-postgres.mjs.
DATABASE_URL=
DIRECT_DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Live updates (lib/use-live-refresh.ts). Public by design: built into the page, so set them as plain (not sensitive)
# variables in Vercel and redeploy after a change. Use the publishable key (sb_publishable_...), never the secret key.
# Without them pages still work and only need a manual reload to show other users' saves.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
